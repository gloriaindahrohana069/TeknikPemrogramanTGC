from abc import ABC, abstractmethod 
# Abstract Class
class Survey(ABC):
    @abstractmethod
    def processing(self):
        pass

class SeismikSurvey(Survey):
    def processing(self):
        print("Processing Seismik Survey: filtering data seismik...")

class GravitySurvey(Survey):
    def processing(self):
        print("Processing Gravity Survey: upward continuatiuon...")
        
class MagnetikSurvey(Survey):
    def processing(self):
        print("Processing Magnetik Survey: anomaly mapping...")

# test 2 class abstrak survey
surveys = [SeismikSurvey(), GravitySurvey(), MagnetikSurvey()]
for s in surveys: 
    s.processing()
